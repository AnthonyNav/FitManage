<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Actualizar Profesionista</title>
    <link rel="stylesheet" href="/CSS/RegistrarAlumno.css">
</head>

<body>

    <div class="container">
        <header>
            <h1>ADMINISTRADOR</h1>
            <p>Actualice los siguientes datos:</p>
        </header>
        <form action="/actualizar-profesionista" method="POST">
            <input type="hidden" name="id_alumno" value="<%= profesionista.id_alumno %>">

            <!-- Grado de estudios -->
            <div class="form-row">
                <label>Grado de estudios</label>
                <select name="grado_estudios" required>
                    <option value="">Seleccione su grado de estudios</option>
                    <option value="primaria" <%= profesionista.grado_estudios === 'primaria' ? 'selected' : '' %>>Primaria</option>
                    <option value="secundaria" <%= profesionista.grado_estudios === 'secundaria' ? 'selected' : '' %>>Secundaria</option>
                    <option value="bachiller" <%= profesionista.grado_estudios === 'bachiller' ? 'selected' : '' %>>Bachiller</option>
                    <option value="universidad" <%= profesionista.grado_estudios === 'universidad' ? 'selected' : '' %>>Universidad</option>
                </select>
            </div>

            <!-- Carrera -->
            <div class="form-row">
                <label>Carrera</label>
                <input type="text" name="carrera" placeholder="Ingrese su carrera" value="<%= profesionista.carrera %>" required>
            </div>

            <!-- Lugar de trabajo -->
            <div class="form-row">
                <label>Lugar de trabajo</label>
                <input type="text" name="lugar_trabajo" placeholder="Ingrese su lugar de trabajo" value="<%= profesionista.lugar_trabajo %>" required>
            </div>

            <!-- Puesto -->
            <div class="form-row">
                <label>Puesto</label>
                <input type="text" name="puesto" placeholder="Ingrese su puesto" value="<%= profesionista.puesto %>" required>
            </div>

            <button type="submit">Actualizar Profesionista</button>
        </form>
    </div>

</body>

</html>
