<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulario de Administrador</title>
    <link rel="stylesheet" href="/CSS/RegistrarAlumno.css">
</head>

<body>

    <div class="container">
        <header>
            <h1>ADMINISTRADOR</h1>
            <p>Ingrese los siguientes datos:</p>
        </header>
        <form action="/registrar-profesionista" method="POST">
            <input type="hidden" name="email" value="<%= email %>">

            <!-- Grado de estudios -->
            <div class="form-row">
                <label>Grado de estudios</label>
                <select name="grado_estudios" required>
                    <option value="">Seleccione su grado de estudios</option>
                    <option value="primaria">Primaria</option>
                    <option value="secundaria">Secundaria</option>
                    <option value="bachiller">Bachiller</option>
                    <option value="universidad">Universidad</option>
                </select>
            </div>

            <!-- Carrera -->
            <div class="form-row">
                <label>Carrera</label>
                <input type="text" name="carrera" placeholder="Ingrese su carrera" required>
            </div>

            <!-- Lugar de trabajo -->
            <div class="form-row">
                <label>Lugar de trabajo</label>
                <input type="text" name="lugar_trabajo" placeholder="Ingrese su lugar de trabajo" required>
            </div>

            <!-- Puesto -->
            <div class="form-row">
                <label>Puesto</label>
                <input type="text" name="puesto" placeholder="Ingrese su puesto" required>
            </div>

            <button type="submit">Registrar Alumno</button>
        </form>
    </div>

</body>

</html>
