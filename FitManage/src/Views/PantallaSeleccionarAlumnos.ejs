<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Estudiantes</title>
    <link rel="stylesheet" href="/CSS/SeleccionarAlumno.css">
</head>
<body>
    <div class="container">
        <h1>Lista de Alumnos</h1>
        <p style="color: red;" class="footer"><%= error %></p>
        <div class="search-bar">
            <input type="text" id="searchInput" placeholder="Buscar (Por nombre, correo o telefono)">
        </div>
            <table>
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Telefono</th>
                        <th>Tipo de alumno</th>
                    </tr>
                </thead>
                <tbody id="studentsTable">
                    <% students.forEach(student => { %>
                        <tr class="row">
                            <form method="POST" action="/registrar-pago">
                                <input type="hidden" name="id_alumno" value="<%= student.id_alumno %>">
                                <input type="hidden" name="nombre" value="<%= student.nombre + ' ' + student.apellidos%>">
                                <input type="hidden" name="email" value="<%= student.email %>">
                                <td><button type="submit" class="row-btn"><%= student.nombre + ' ' + student.apellidos%></button></td>
                                <td><button type="submit" class="row-btn"><%= student.email %></button></td>
                                <td><button type="submit" class="row-btn"><%= student.telefono %></button></td>
                                <td><button type="submit" class="row-btn"><%= student.type_alumno %></button></td>
                            </form>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
    </div>

    <script>
        const searchInput = document.getElementById("searchInput");
        const tableRows = Array.from(document.querySelectorAll("#studentsTable tr"));

        // Evento de búsqueda
        searchInput.addEventListener("input", () => {
            const filter = searchInput.value.toLowerCase();
            tableRows.forEach(row => {
                const name = row.cells[0].textContent.toLowerCase();
                const email = row.cells[1].textContent.toLowerCase();
                const phone = row.cells[2].textContent.toLowerCase();
                if (name.includes(filter) || email.includes(filter) || phone.includes(filter)){
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        });
    </script>
</body>
</html>

        
